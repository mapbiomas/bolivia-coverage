// Compute per‑year boxplot statistics for a given class and index
var getStats = function(feat, clase, Nindice, ye) {
  var res = feat
    .filter(ee.Filter.eq('reference', clase))
    .filter(ee.Filter.eq('year', ye));
  
  var CalcularEstadisticas = function() {
    var p1 = ee.Number(res.reduceColumns(ee.Reducer.percentile([25]), [Nindice]).get('p25'));
    var p2 = ee.Number(res.reduceColumns(ee.Reducer.percentile([50]), [Nindice]).get('p50'));
    var p3 = ee.Number(res.reduceColumns(ee.Reducer.percentile([75]), [Nindice]).get('p75'));
    var p4 = ee.Number(res.reduceColumns(ee.Reducer.percentile([100]), [Nindice]).get('p100'));
    var mean = ee.Number(feat.reduceColumns(ee.Reducer.mean(), [Nindice]).get('mean'));
    var median = ee.Number(feat.reduceColumns(ee.Reducer.median(), [Nindice]).get('median'));
    var IQR = p3.add(p1.multiply(-1));
    var LimInf = p1.add(IQR.multiply(-1.5));
    var LimSup = p3.add(IQR.multiply(1.5));

    return ee.FeatureCollection(ee.Feature(null, {
      clase: clase,
      Nindice: Nindice,
      year: ye,
      mean: mean,
      median: median,
      p1: p1,
      p2: p2,
      p3: p3,
      p4: p4,
      IQR: IQR,
      LimInf: LimInf,
      LimSup: LimSup,
    }));
  };
  
  return ee.Algorithms.If(res.size().gt(0), CalcularEstadisticas(), ee.FeatureCollection([]));
};

// Optional: print sample counts for verification
var Veriricar = function(feat, clase, Nindice, ye) {
  var res = feat
    .filter(ee.Filter.eq('reference', clase))
    .filter(ee.Filter.eq('year', ye));
  print('class-' + clase + '-' + ye, res.size());
};

// Aggregate annual statistics across years and print summary values
var getStatsAnualTotal = function(feat, clase, Indices) {
  print('Stats Class-' + clase);
  
  Indices.forEach(function(ind, i) {
    var filtro = feat
      .filter(ee.Filter.eq('Nindice', ind))
      .filter(ee.Filter.eq('clase', clase));
    
    var AddStats = function(mat) {
      var MedianLimInf = ee.Number(filtro.reduceColumns(ee.Reducer.mean(), ['LimInf']).get('mean'));
      var MedianLimSup = ee.Number(filtro.reduceColumns(ee.Reducer.mean(), ['LimSup']).get('mean'));
      var mean = ee.Number(filtro.reduceColumns(ee.Reducer.mean(), ['mean']).get('mean'));
      var median = ee.Number(filtro.reduceColumns(ee.Reducer.mean(), ['median']).get('mean'));
      return [MedianLimInf, MedianLimSup, mean, median];
    };
    
    var array = ee.List(ee.Algorithms.If(filtro.size().gt(0), AddStats(), [0, 0, 0, 0]));
    
    print(ee.String(ind + '-MedLimInf').cat(' ').cat(array.get(0)));
    print(ee.String(ind + '-MedLimSup').cat(' ').cat(array.get(1)));
    print(ee.String(ind + '-mean').cat('  ').cat(array.get(2)));
    print(ee.String(ind + '-median').cat('  ').cat(array.get(3)));
  });
  
  return []; // The function only prints, does not return a collection
};

